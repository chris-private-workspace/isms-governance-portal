# =============================================================================
# .env.example — copy to .env and fill in. NEVER commit .env (see .gitignore).
#
# This file lists only the variables W01 (M0) actually reads. Variables are
# added when the code that consumes them lands — not in advance. A .env.example
# full of unused keys teaches people to ignore it.
#
# ⚠️ Production runs in a SEPARATE Azure subscription (ADR-0010). Its secrets
#    and endpoints are NOT a superset of staging's — do not build one file with
#    switches. Production values come from Key Vault, which the infra team owns.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Ports (verified free on 2026-08-08; see W01 progress.md D-ports) ---------
API_PORT=3210
WEB_PORT=3200

# The interface the API binds to. Loopback by default and that is the safe
# default, not an oversight: binding 0.0.0.0 on a developer machine publishes an
# API with a development principal to the whole network. Containers must set
# 0.0.0.0 explicitly, because there the loopback default means "unreachable".
# apps/api/src/bootstrap/main.ts:59
API_HOST=127.0.0.1

# --- CORS --------------------------------------------------------------------
# The single origin the API accepts browser requests from. Falls back to
# http://localhost:$WEB_PORT, so local development needs nothing here. Every
# deployed environment DOES need it — the fallback would silently allow nothing
# useful and the failure surfaces as an opaque browser CORS error.
# apps/api/src/bootstrap/security.ts:137
# WEB_ORIGIN=https://<web-host>

# --- Development principal (M4 removes this entirely) -------------------------
# ⚠️ THIS IS NOT AUTHENTICATION. Until Entra ID lands (ADR-0001 / ADR-0015) the
# API resolves the caller from these variables. dev-principal.ts refuses to load
# under NODE_ENV=production at module construction time, so a production build
# does not start at all rather than start with a forged principal — that is why
# apps/api is not deployed yet (W21 plan §Summary).
# apps/api/src/modules/policy/dev-principal.ts:100,109
DEV_PRINCIPAL_ENTITIES=HK1
DEV_PRINCIPAL_ROLLUP=false

# --- Demonstration deployment ------------------------------------------------
# Unset means refused. The web demo hands out persona sessions only when this is
# exactly "enabled"; anything else (including empty) throws at request time.
# Silence is refusal, so a production deployment has to opt in ON PURPOSE.
# Verified on the deployed URL in W21 Day 4: removing it took
# POST /api/demo-session from 200 to 500 while / and /login stayed 200.
# apps/web/src/lib/demo-session.ts:61
# DEMO_AUTH=enabled

# --- Database ----------------------------------------------------------------
# Local development only. docker/compose.yml starts this exact server.
# The credentials below are throwaway values for a container that is not
# reachable outside the developer's machine.
#
# ⚠️ TWO ROLES, TWO URLS, AND THE DIFFERENCE IS LOAD-BEARING (W02).
# POSTGRES_USER is a SUPERUSER — measured: rolsuper=t, rolbypassrls=t. A
# superuser bypasses row-level security completely, and FORCE ROW LEVEL
# SECURITY does not constrain it. An application connecting as that role has no
# entity isolation whatsoever, however correct the policies are, and every test
# still passes. So:
#   DATABASE_URL         -> the application. Least privilege, RLS applies.
#   DATABASE_URL_MIGRATE -> prisma migrate only. Owns the schema, bypasses RLS.
# prisma.config.ts:11-15 anticipated this split in W01; W02 made it real.
POSTGRES_USER=isms_dev
POSTGRES_PASSWORD=isms_dev_local_only
POSTGRES_DB=isms_dev
POSTGRES_APP_USER=isms_app_user
POSTGRES_APP_PASSWORD=isms_app_local_only

DATABASE_URL=postgresql://isms_app_user:isms_app_local_only@localhost:5433/isms_dev?schema=public
DATABASE_URL_MIGRATE=postgresql://isms_dev:isms_dev_local_only@localhost:5433/isms_dev?schema=public

# --- Web -> API --------------------------------------------------------------
# NEXT_PUBLIC_* is exposed to the browser. Only ever put non-secret values here.
NEXT_PUBLIC_API_URL=http://localhost:3210
