# --- Confidential source material (kept local, never pushed) ---
# reference/           : Secure-Development Guidance + DoD checklist derived
#                        from the organisation's own Qualys/Rapid7 scan results
# docs/reference/      : RCI company procedures, Risk Management Report,
#                        APAC ISMS profile, and licensed ISO 27001/27002 PDFs
# The docs/00-16 set carries everything the build needs; these raw artifacts
# stay on local disk only.
/reference/
/docs/reference/

