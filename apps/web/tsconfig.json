{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next.js bundles; it does not want NodeNext resolution or emitted JS.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // `process.env.NEXT_PUBLIC_*` in components and node:fs in the i18n test
    // both need Node's types; without this only DOM globals are in scope.
    "types": ["node"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "declaration": false,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
