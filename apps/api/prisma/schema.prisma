// File: apps/api/prisma/schema.prisma
// Purpose: The entity graph, 13 models in. Every table here is on 02a §0's index.
// Category: core-model
// Scope: Phase W01 (M0) → W07 (M1 slice 4)
// Owner: docs/02-architecture/02a-data-model-spec.md §0 (entity index)
//
// Description:
//   The models here are not a sample of 02a — they are the SHAPE the remaining
//   Wave-1 entities copy: base fields, soft delete, entity scoping by RLS,
//   governed extensions, and a server-issued ref_code.
//
//   ⚠️ Slice 4 added a SECOND shape, because the first one ran out. Cross-entity
//   references were closed by a composite foreign key until a parent (Control)
//   refused the anchor and a child (Evidence) had no foreign key at all. Those two
//   are guarded by a SECURITY INVOKER trigger instead — see ControlTest's header
//   for what W07 Day 1 measured, and why a plain foreign key is not enough.
//
//   ⚠️ Every business table added from M1 on MUST carry `entity_id NOT NULL`,
//   including child tables (CLAUDE.md 約束 8). That redundancy is intentional:
//   it lets an RLS policy attach directly to the child rather than trusting a
//   join to be written correctly.
//
//   ⚠️ TWO tables are exempt, and each states its own reason in its docstring:
//   `org_entities` (it DEFINES scope) and `users` (scope belongs to the role
//   assignment, not the person — ADR-0012). Nothing else is exempt; adding a
//   third requires justification in the PR description
//   (rules-on-demand/multi-tenant-data.md).
//
// Created: 2026-08-08 (Phase W01)
// Last Modified: 2026-08-12
//
// Modification History (newest-first):
//   - 2026-08-12: Phase W07 — ControlTest + Evidence; trigger-guarded references
//   - 2026-08-10: Phase W04 — User (ADR-0012), ref_code counters, Policy base fields
//   - 2026-08-10: Phase W03 — governed extensions (ADR-0005): JSONB + catalog
//   - 2026-08-09: Phase W02 — first two tables, entity-scoped by RLS
//   - 2026-08-08: Initial creation (Phase W01) — datasource + generator only

// Prisma 7 removed `url` from the datasource block (P1012). The connection
// URL for migrate/introspect now lives in ../prisma.config.ts, and the runtime
// client gets its connection from the driver adapter in
// src/core-model/prisma.service.ts. Two consumers, two explicit paths — the
// schema no longer holds a connection string at all.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// === Naming: DB columns are snake_case, Prisma properties are camelCase ===
// Why: 02a specifies columns in snake_case (`org_entity_id` at 02a:90) and every
// module document follows it, while Prisma's own convention is camelCase. @map
// keeps both idiomatic instead of forcing one side to read wrong. The column
// name is the one that appears in RLS policies, so it is the one that has to
// match the design documents exactly.
//
// ⚠️ `org_entity_id`, NOT `entity_id`. Six documents under docs/02-architecture/
// use `org_entity_id` (02a:90 · 03:99 · 11:73 · 12:42 · 13:37 · 17:35); the
// `entity_id` spelling appears only in lower-authority places, which CLAUDE.md's
// authority ordering settles in favour of the design documents (W02 D-fieldname).

enum OrgEntityType {
  region
  country
  legal_entity
  business_unit

  @@map("org_entity_type")
}

/// The scoping and roll-up spine (02a:25). Deliberately has NO org_entity_id of
/// its own: it *defines* scope, so filtering it by scope would make the
/// hierarchy unresolvable (multi-tenant-data.md:61 lists it as a legitimate
/// global table).
model OrgEntity {
  id       String        @id @default(uuid()) @db.Uuid
  code     String        @unique
  name     String
  type     OrgEntityType
  parentId String?       @map("parent_id") @db.Uuid

  /// Materialised hierarchy path (02a:146), e.g. "/apac/sg/sg-pte-ltd".
  /// This is what makes an authorised-subtree roll-up a prefix match instead of
  /// a recursive CTE inside an RLS policy, where a CTE would run per row.
  path String

  parent          OrgEntity?       @relation("OrgEntityHierarchy", fields: [parentId], references: [id])
  children        OrgEntity[]      @relation("OrgEntityHierarchy")
  policies        Policy[]
  extensionFields ExtensionField[]
  refCodeCounters RefCodeCounter[]
  assetGroups     AssetGroup[]
  assets          Asset[]
  risks           Risk[]
  controls        Control[]
  controlTests    ControlTest[]
  evidence        Evidence[]

  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([path])
  @@map("org_entities")
}

/// Identity data — the third class, and the SECOND table with no org_entity_id.
///
/// The reason differs from OrgEntity's. OrgEntity is global because it *defines*
/// scope. `users` is global because **scope is not a property of a person**:
/// 03:31 states a user's scope is derived from their role assignment, and a
/// regional ISO legitimately spans 13 OpCos. Settled in ADR-0012, which also
/// records the cost — a global table of people is cross-entity readable by
/// construction, so who may ENUMERATE users is an M4 application-layer decision
/// that RLS cannot answer.
///
/// ⚠️ Deliberately absent, do not add without a consumer (02a §3.2):
///   - a password column — authentication is delegated to OIDC (05 §Identity)
///   - `home_org_entity_id` — an employer field sitting next to a deliberately
///     absent org_entity_id would be read as the scope anchor, which is the one
///     misreading ADR-0012 exists to prevent
///   - `last_login`, any role/permission column — M4
model User {
  id String @id @default(uuid()) @db.Uuid

  /// The IdP's subject claim: the join key to the identity provider, and the
  /// only thing here that is not a display concern.
  oidcSubject String @unique @map("oidc_subject")
  email       String
  displayName String @map("display_name")

  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  ownedPolicies   Policy[] @relation("PolicyOwner")
  createdPolicies Policy[] @relation("PolicyCreatedBy")
  updatedPolicies Policy[] @relation("PolicyUpdatedBy")

  ownedAssetGroups AssetGroup[] @relation("AssetGroupOwner")
  ownedAssets      Asset[]      @relation("AssetOwner")
  custodiedAssets  Asset[]      @relation("AssetCustodian")
  ownedRisks       Risk[]       @relation("RiskOwner")
  ownedControls    Control[]    @relation("ControlOwner")

  /// Both sides of 02a:416's segregation-of-duties rule, as separate relations.
  /// The rule (reviewer ≠ tester) is enforced at the review transition, which does
  /// not exist yet — these columns are what it will read, not a check in disguise.
  testedControlTests   ControlTest[] @relation("ControlTestTester")
  reviewedControlTests ControlTest[] @relation("ControlTestReviewer")

  @@map("users")
}

/// One row per (entity, record type). The sequence behind `ref_code`.
///
/// ⚠️ Entity-scoped ON PURPOSE, and this is the interesting part: issuing a
/// reference code for another entity is exactly the cross-entity write RLS
/// exists to refuse. Because the counter carries org_entity_id, "may this
/// principal issue a code for HK1?" is answered by the same policy that answers
/// "may it write a HK1 policy?" — one mechanism, not two.
///
/// A counter table rather than a PostgreSQL sequence: a sequence would have to
/// be created per (type, entity) — hundreds of them, by DDL, on the request
/// path. This is one row, and the row lock only blocks the same pair (W04 D3).
model RefCodeCounter {
  orgEntityId String @map("org_entity_id") @db.Uuid
  entityType  String @map("entity_type")

  /// Last issued number. The next code is this + 1, allocated atomically by
  /// UPDATE ... RETURNING (see ref-code.ts).
  lastSeq Int @default(0) @map("last_seq")

  orgEntity OrgEntity @relation(fields: [orgEntityId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([orgEntityId, entityType])
  @@map("ref_code_counters")
}

/// The one business table W04 needed. Policy was chosen over Risk because every
/// one of its fields is scalar (02a:189), whereas Risk carries FKs to Asset,
/// Threat and Vulnerability — which W05 has since built, below.
///
/// ⚠️ STILL INCOMPLETE, and the omissions are listed rather than left to be
/// discovered. W04 closed the base-field half; what remains is module work:
///   - `ref_code`      — DELIVERED in W04, issued by ref_code_counters
///   - `status`        — DELIVERED in W04 as a column. ⚠️ The TRANSITIONS are
///                       NOT enforced by anything: any value may be written over
///                       any other. The state machine in 02a §4 becomes real at
///                       M5, and until then this column records intent, not a
///                       guarantee. Do not read its presence as a workflow.
///   - `owner_user_id` — DELIVERED in W04 (nullable: no assignment path yet)
///   - `created_by` / `updated_by` — same; users arrive from an IdP at M4, so
///                       nothing can populate these on the write path today
///   - `is_active`     — NOT BUILT, deliberately. 02a:98 calls it a derived
///                       convenience flag; storing it creates a second truth
///                       that can disagree with retired_at (W04 D2)
///   - `extensions`    — DELIVERED in W03 (ADR-0005), see the field below
///   - `category`, `effective_date`, `review_due`, `body_ref`,
///     `requires_attestation` — the Policy module itself (M6)
model Policy {
  id String @id @default(uuid()) @db.Uuid

  /// `<TYPE>-<ENTITY_CODE>-<seq>` (02a:103), issued by ref_code_counters.
  ///
  /// ⚠️ NEVER caller-supplied. A caller who can choose this value can probe for
  /// another entity's records: unique constraints are enforced beneath RLS, so a
  /// collision would answer "does POL-HK1-000007 exist?" to someone who cannot
  /// see HK1 at all. Issuing it server-side keeps that question unaskable.
  refCode String @unique @map("ref_code")

  /// The whole point of this phase. NOT NULL, FK, and first in the composite
  /// index because scope filtering is the first predicate of every query
  /// (multi-tenant-data.md:50).
  orgEntityId String @map("org_entity_id") @db.Uuid

  title   String
  version Int    @default(1)

  /// The six states of 02a:300-312. The enum is real; the TRANSITIONS are not
  /// guarded by anything until M5 — see the block comment above.
  status PolicyStatus @default(draft)

  /// All three are nullable because M4 owns the only paths that could fill them.
  /// A NOT NULL here today would mean inventing a user to satisfy a constraint,
  /// which is worse than an honest absence.
  ownerUserId String? @map("owner_user_id") @db.Uuid
  createdBy   String? @map("created_by") @db.Uuid
  updatedBy   String? @map("updated_by") @db.Uuid

  /// Governed local extensions (ADR-0005). Every key must be declared in
  /// `extension_fields`; a database trigger refuses undeclared keys, wrong types
  /// and missing required fields.
  ///
  /// ⚠️ RLS does NOT see into this column — measured in W03 Day 0. A row whose
  /// column says SG1 and whose JSONB claims org_entity_id = HK1 is accepted (and
  /// still invisible to HK1, so there is no read leak). Anything that must be
  /// scope-filtered is a COLUMN, never an extension key.
  extensions Json @default("{}") @db.JsonB

  orgEntity     OrgEntity @relation(fields: [orgEntityId], references: [id])
  owner         User?     @relation("PolicyOwner", fields: [ownerUserId], references: [id])
  createdByUser User?     @relation("PolicyCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?     @relation("PolicyUpdatedBy", fields: [updatedBy], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete (guardrail 3) — a RECORD-level marker, and not the same thing
  /// as `status = retired`, which is a LIFECYCLE state a policy can legitimately
  /// sit in while still being a live, visible record.
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  @@index([orgEntityId, retiredAt])
  @@map("policies")
}

/// The lifecycle in 02a:300-312, verbatim. Snake_case labels so the database
/// enum reads the way the design document writes it.
enum PolicyStatus {
  draft
  in_review
  approved
  published
  under_revision
  retired

  @@map("policy_status")
}

enum ExtensionDataType {
  string
  number
  boolean

  @@map("extension_data_type")
}

/// The central field catalog — the mechanism that makes an extension *governed*
/// rather than merely permitted (ADR-0005). Adding a local field is an insert
/// here, not a schema change.
///
/// `org_entity_id` is NULLABLE on purpose: NULL means a group-wide field. W03
/// measured that one table serves both — a global key is accepted, an entity's
/// own key is accepted, and another entity's key is refused.
///
/// ⚠️ Uniqueness needs TWO PARTIAL indexes, not `@@unique`. In PostgreSQL a
/// UNIQUE constraint treats every NULL as distinct, so `@@unique([entityType,
/// key, orgEntityId])` would happily accept the same global key twice. Prisma
/// cannot express partial indexes, so they live in the migration SQL.
model ExtensionField {
  id String @id @default(uuid()) @db.Uuid

  /// NULL = group-wide. Non-null = declared by, and only usable by, that entity.
  orgEntityId String? @map("org_entity_id") @db.Uuid

  /// Which canonical entity this field extends, e.g. "policy".
  entityType String            @map("entity_type")
  key        String
  dataType   ExtensionDataType @map("data_type")
  required   Boolean           @default(false)

  orgEntity OrgEntity? @relation(fields: [orgEntityId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  @@index([entityType, key])
  @@map("extension_fields")
}

// ===========================================================================
// W05 — the asset-based risk chain (M1 slice 2)
// ===========================================================================
// 已確認參數 #8 makes the methodology asset-based: asset group -> asset ->
// threat -> vulnerability -> CIA. A Risk is the INTERSECTION of those, which is
// why its three FKs are NOT NULL — a risk that names no asset is not an
// incomplete record under this methodology, it is a different methodology.
//
// ⚠️ EVERY FK BETWEEN TWO ENTITY-SCOPED TABLES HERE IS COMPOSITE, and that is a
// security control rather than a modelling preference. W05 Day 2 measured that
// PostgreSQL's referential-integrity check BYPASSES row-level security: a
// principal scoped to SG1 successfully created a row pointing at an HK1 parent
// it could not see. Carrying org_entity_id into the FK makes the cross-entity
// link unrepresentable, and — measured in the same probe — an id outside the
// scope and an id that does not exist produce the IDENTICAL error, so the
// constraint cannot be used as an existence oracle either.
//
// The redundant org_entity_id on child tables (約束 8 iron law 1) is what makes
// this possible. That redundancy was always deliberate; this is the first phase
// where it pays for itself.

/// The six categories at 02a:202, verbatim. `physical_and_virtual` is one
/// category, not two — the source writes "physical & virtual".
enum AssetCategory {
  services
  people
  intangible
  physical_and_virtual
  software
  information

  @@map("asset_category")
}

/// 02a:208's three values. Not a security clearance and not the CIA triad —
/// this is the sensitivity label carried by the asset itself.
enum AssetClassification {
  internal
  restricted
  confidential

  @@map("asset_classification")
}

/// The seven non-empty combinations of C/I/A (02a:118, 02a:193).
///
/// An enum rather than three booleans because three booleans can express
/// "affects none of C, I or A", which is not a risk. Nothing today queries by a
/// single component; when something does, `cia_type LIKE '%i%'` still answers it
/// (W05 D3).
enum CiaType {
  c
  i
  a
  ci
  ca
  ia
  cia

  @@map("cia_type")
}

/// 02a:121.
enum RiskTreatment {
  accept
  mitigate
  transfer
  avoid

  @@map("risk_treatment")
}

/// 02a:120's acceptance criteria. NEVER written by a caller — this is a
/// generated column (ADR-0013), so the type exists only to name the two values.
enum RiskAcceptanceStatus {
  acceptable
  requires_treatment

  @@map("risk_acceptance_status")
}

/// The lifecycle at 02a:343-353.
///
/// ⚠️ Same caveat as PolicyStatus: the enum is real, the TRANSITIONS are not
/// enforced by anything until M5. Any value may be written over any other.
///
/// ⚠️ `it_risk_register` overlaps `Risk.inItRiskRegister`, which is derived from
/// the residual score. They are NOT kept in agreement by anything — the status
/// records what a human says the risk is doing, the boolean records what the
/// numbers say. When they disagree that is information, not corruption; a rule
/// that reconciles them belongs to M5's state machine.
enum RiskStatus {
  identified
  assessed_before
  treated
  assessed_after
  it_risk_register
  monitored
  closed

  @@map("risk_status")
}

/// 02a:122, verbatim.
enum ControlType {
  preventive
  detective
  corrective

  @@map("control_type")
}

/// 02a:123, verbatim. `09:54` repeats these three; it is a screen brief
/// restating the data model, not a second authority (W06 D3).
enum ControlNature {
  manual
  automated
  hybrid

  @@map("control_nature")
}

/// 02a:124, verbatim.
///
/// Required rather than optional on `Control`, because `event_driven` already
/// IS the "no fixed schedule" answer — a control with no cadence has a value
/// here, not a NULL. Making it nullable would add a second way to say the same
/// thing and no way to tell them apart.
enum ControlFrequency {
  continuous
  daily
  weekly
  monthly
  quarterly
  annual
  event_driven

  @@map("control_frequency")
}

/// 02a:125, verbatim.
///
/// ⚠️ `not_tested` IS NOT A PLACEHOLDER, and it stays the only reachable value
/// even now that `ControlTest` exists (W07). 02a:418 derives this column from the
/// latest COMPLETED test, and W07 ships a create-only test registry: nothing moves
/// a test to a terminal state, so nothing has a completed test to derive from.
/// A control nobody has finished testing is not `effective`; saying so would be
/// the platform asserting a governance claim it was never given.
///
/// The derivation arrives with the review transition, which is also where 02a:416
/// puts the segregation-of-duties check. Both wait for the same slice.
enum ControlEffectiveness {
  not_tested
  effective
  partially_effective
  ineffective

  @@map("control_effectiveness")
}

/// Which entities a control governs (02a:217, ADR-0014).
///
/// ⚠️ TWO VALUES, NOT THREE. 02a:217 also lists `subtree`, and it is deliberately
/// absent: scope resolution expands DOWNWARD only (entity-scope.resolver.ts:120-142
/// — assignment roots plus descendants, never ancestors), so a reader's scope can
/// never contain the parent that owns a subtree control. Shipping the value would
/// give users a setting that changes nothing and reports nothing — AP-3 exactly.
/// Adding it later is an enum value plus a policy branch; ADR-0014 §可證偽條件
/// carries the condition.
enum ControlAppliesToScope {
  entity
  group

  @@map("control_applies_to_scope")
}

/// The ControlTest lifecycle, 02a §4 verbatim (Scheduled -> InProgress ->
/// Passed | Partial | Failed).
///
/// ⚠️ THESE FIVE ARE ALSO THE `result` COLUMN 02a:225 ASKS FOR, which is why that
/// column is not built. Passed / Partial / Failed are not a status that happens to
/// accompany a result — they ARE the result, and §4 already names them as states.
/// Two columns would be two ways to say one thing with no way to tell them apart
/// when they disagree; ControlFrequency records the same reasoning for NULL.
///
/// Omitting a field the spec lists is a deviation under 已確認參數 #9 just as
/// inventing one is, so it is written down in both places — here and at 02a:225.
enum ControlTestStatus {
  scheduled
  in_progress
  passed
  partial
  failed

  @@map("control_test_status")
}

/// What a piece of evidence is attached to (02a:227).
///
/// ⚠️ ONE VALUE, NOT THREE. 02a:227 also names attestation and assessment; neither
/// table exists. An enum value whose target table is absent is a setting that can
/// be chosen and then does nothing — the same AP-3 that kept `subtree` out of
/// ControlAppliesToScope (ADR-0014). Adding a value later is one line here, one
/// branch in the trigger, and a test; that is the cost of waiting, and it is
/// smaller than the cost of shipping a link that resolves to nothing.
enum EvidenceLinkedType {
  control_test

  @@map("evidence_linked_type")
}

/// Groups assets for assessment (02a:202), per the Risk Management Report.
///
/// ⚠️ No `status` column. 02a §1.1 defines `status` as "per the entity's state
/// machine (§4)", and §4 defines lifecycles for Policy, Risk, Issue and
/// ControlTest only. Giving this table a status would mean inventing its states
/// (已確認參數 #9).
model AssetGroup {
  id String @id @default(uuid()) @db.Uuid

  /// `AGRP-<ENTITY_CODE>-<seq>`. Server-issued; see ref-code.ts for why the
  /// caller never supplies one.
  refCode String @unique @map("ref_code")

  orgEntityId String @map("org_entity_id") @db.Uuid

  name          String
  assetCategory AssetCategory @map("asset_category")
  description   String?

  ownerUserId String? @map("owner_user_id") @db.Uuid
  createdBy   String? @map("created_by") @db.Uuid
  updatedBy   String? @map("updated_by") @db.Uuid

  version    Int  @default(1)
  extensions Json @default("{}") @db.JsonB

  orgEntity OrgEntity @relation(fields: [orgEntityId], references: [id])
  owner     User?     @relation("AssetGroupOwner", fields: [ownerUserId], references: [id])
  assets    Asset[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  /// The anchor a composite FK needs. `id` alone is already unique; this pair
  /// exists so a child can reference (id, org_entity_id) together — see the
  /// block comment above.
  @@unique([id, orgEntityId])
  @@index([orgEntityId, retiredAt])
  @@map("asset_groups")
}

/// The asset inventory (02a:208). Promoted to Wave 1 because an asset-based
/// methodology cannot assess risk without it.
///
/// ⚠️ `asset_owner_user_id` (02a:208) is NOT a separate column. 02a §1.1 already
/// gives every entity an `owner_user_id` described as the "Accountable owner",
/// and §3 names the same role contextually per entity (`risk_owner_user_id`,
/// `assessor_user_id`, …). Two columns for one concept is how a module invents a
/// private definition of a shared one (guardrail 3). `custodian_user_id` IS a
/// second column, because a custodian is a different person doing a different
/// job — the one who operates the asset, not the one accountable for it.
///
/// ⚠️ Deliberately absent, do not add without a domain (W05 D8):
///   - `value`       — 02a:208 names it; §2 never defines its scale. Monetary?
///                     1–5? High/Medium/Low? Building it means choosing.
///   - `criticality` — same. And the 5-point scale at 02a:116 is not available
///                     to borrow: its descriptors describe risk IMPACT, not what
///                     an asset is worth.
///   Nothing in W05 reads either. Recorded as AD-AssetScales-1.
model Asset {
  id String @id @default(uuid()) @db.Uuid

  /// `AST-<ENTITY_CODE>-<seq>`.
  refCode String @unique @map("ref_code")

  orgEntityId String @map("org_entity_id") @db.Uuid

  name         String
  assetGroupId String @map("asset_group_id") @db.Uuid

  /// Repeated from the group on purpose — 02a:208 lists it on Asset as well, and
  /// an asset may be categorised differently from the group it is assessed with.
  assetCategory  AssetCategory       @map("asset_category")
  classification AssetClassification

  ownerUserId     String? @map("owner_user_id") @db.Uuid
  custodianUserId String? @map("custodian_user_id") @db.Uuid
  createdBy       String? @map("created_by") @db.Uuid
  updatedBy       String? @map("updated_by") @db.Uuid

  version    Int  @default(1)
  extensions Json @default("{}") @db.JsonB

  orgEntity OrgEntity @relation(fields: [orgEntityId], references: [id])
  owner     User?     @relation("AssetOwner", fields: [ownerUserId], references: [id])
  custodian User?     @relation("AssetCustodian", fields: [custodianUserId], references: [id])
  risks     Risk[]

  /// Composite: an asset cannot be filed under another entity's group.
  assetGroup AssetGroup @relation(fields: [assetGroupId, orgEntityId], references: [id, orgEntityId])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  @@unique([id, orgEntityId])
  @@index([orgEntityId, retiredAt])
  @@index([assetGroupId])
  @@map("assets")
}

/// Reusable threat library (02a:198) — GLOBAL, no org_entity_id.
///
/// ⚠️ This table does not introduce an exemption; it CONSUMES one that already
/// exists. `rules-on-demand/multi-tenant-data.md:63` lists the threat and
/// vulnerability libraries among the five legitimate global reference tables,
/// on the ground that 已確認參數 #8 makes them shared group-wide catalogues.
/// W04 had to EXTEND that rule (identity was a class it never covered); this is
/// the first table that simply matches a row already on the list.
///
/// Two consequences follow from being global, and neither is an oversight:
///   - no `ref_code` — codes are issued per entity by ref_code_counters, and
///     there is no entity here to issue against. `users` is global for a
///     different reason and reaches the same place.
///   - no `extensions` — validate_extensions() reads NEW.org_entity_id
///     unconditionally (governed_extensions migration, lines 112/116/140), so
///     attaching it to a table without that column is a runtime error, not a
///     policy choice.
model Threat {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique
  description String?
  category    String?

  risks Risk[]

  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  @@map("threats")
}

/// Reusable vulnerability library (02a:200) — GLOBAL. Same reasoning as Threat.
model Vulnerability {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique
  description String?
  category    String?

  risks Risk[]

  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  @@map("vulnerabilities")
}

/// The methodology's centre (02a:193-196): a risk is one asset, one threat, one
/// vulnerability and the CIA property they threaten, scored twice.
///
/// ⚠️ THE FOUR DERIVED COLUMNS ARE NOT IN THIS MODEL, and their absence is the
/// decision. `score_before`, `score_after`, `acceptance_status` and
/// `in_it_risk_register` are PostgreSQL generated columns (ADR-0013): the
/// database computes them in the same write that sets the inputs, so they cannot
/// drift and a caller cannot supply one. Prisma cannot express a generated
/// column, so they are declared below as `@default(dbgenerated(...))` — a mirror
/// of PostgreSQL's own normalised text, which the diff engine compares BYTE FOR
/// BYTE. Never edit those strings by hand; read them back with
/// `pg_get_expr(adbin, adrelid)` after changing the migration.
///
/// ⚠️ Each score set is ALL-OR-NONE, enforced by a CHECK in the migration. This
/// is not tidiness: GREATEST ignores NULL, so a set with two of five impacts
/// filled would produce a confident wrong number rather than an error (measured,
/// W05 Day 0). 02a:343-353 guarantees rows with an empty set — a risk sits in
/// Identified with no before-scores and in Treated with no after-scores — so the
/// constraint has to permit empty and refuse partial, not simply demand full.
model Risk {
  id String @id @default(uuid()) @db.Uuid

  /// `RISK-<ENTITY_CODE>-<seq>` — the one prefix 02a fixes itself (02a:89).
  refCode String @unique @map("ref_code")

  orgEntityId String @map("org_entity_id") @db.Uuid

  title       String
  category    String?
  description String?

  /// The chain. NOT NULL because 已確認參數 #8's methodology defines a risk AS
  /// the intersection — see the block comment at the top of this section.
  assetId         String  @map("asset_id") @db.Uuid
  threatId        String  @map("threat_id") @db.Uuid
  vulnerabilityId String  @map("vulnerability_id") @db.Uuid
  ciaType         CiaType @map("cia_type")

  /// Nullable: a treatment is chosen at the Treated transition, not at creation
  /// (02a:346). Today it is a column, not a link to Control — that arrives with
  /// slice 3, and 02a:393 puts the "a treated risk has ≥1 control" rule at the
  /// transition rather than at creation anyway.
  treatment RiskTreatment?
  reviewDue DateTime?      @map("review_due") @db.Date

  status RiskStatus @default(identified)

  /// before_control (inherent) — 02a:194.
  lkhBefore Int? @map("lkh_before")
  finBefore Int? @map("fin_before")
  bopBefore Int? @map("bop_before")
  lryBefore Int? @map("lry_before")
  repBefore Int? @map("rep_before")
  sisBefore Int? @map("sis_before")

  /// after_control (residual) — 02a:195.
  lkhAfter Int? @map("lkh_after")
  finAfter Int? @map("fin_after")
  bopAfter Int? @map("bop_after")
  lryAfter Int? @map("lry_after")
  repAfter Int? @map("rep_after")
  sisAfter Int? @map("sis_after")

  // === The four generated columns (ADR-0013) ===
  // Every string below was COPIED from PostgreSQL, not written. The source is
  // `SELECT pg_get_expr(adbin, adrelid) ... WHERE attgenerated = 's'`, and
  // Prisma's diff engine compares it to that output byte for byte — W05
  // measured that dropping one pair of outer parentheses makes every later
  // `migrate dev` emit an ALTER COLUMN that then fails to apply, permanently.
  //
  // ⚠️ `@default(dbgenerated(...))` is the closest Prisma can come to saying
  // GENERATED ALWAYS AS ... STORED; it does not mean these have a default. The
  // database refuses a supplied value outright, which is the property ADR-0013
  // was chosen for. Do not expose them as writable fields in any DTO.
  //
  // All four are nullable because an unassessed risk has no score, and NULL is
  // the honest answer — not `false`, and emphatically not `acceptable`.

  scoreBefore Int? @default(dbgenerated("(lkh_before * GREATEST(fin_before, bop_before, lry_before, rep_before, sis_before))")) @map("score_before")
  scoreAfter  Int? @default(dbgenerated("(lkh_after * GREATEST(fin_after, bop_after, lry_after, rep_after, sis_after))")) @map("score_after")

  acceptanceStatus RiskAcceptanceStatus? @default(dbgenerated("\nCASE\n    WHEN ((lkh_after IS NULL) AND (lkh_before IS NULL)) THEN NULL::risk_acceptance_status\n    WHEN (COALESCE((lkh_after * GREATEST(fin_after, bop_after, lry_after, rep_after, sis_after)), (lkh_before * GREATEST(fin_before, bop_before, lry_before, rep_before, sis_before))) >= 16) THEN 'requires_treatment'::risk_acceptance_status\n    ELSE 'acceptable'::risk_acceptance_status\nEND")) @map("acceptance_status")

  inItRiskRegister Boolean? @default(dbgenerated("((lkh_after * GREATEST(fin_after, bop_after, lry_after, rep_after, sis_after)) >= 16)")) @map("in_it_risk_register")

  ownerUserId String? @map("owner_user_id") @db.Uuid
  createdBy   String? @map("created_by") @db.Uuid
  updatedBy   String? @map("updated_by") @db.Uuid

  version    Int  @default(1)
  extensions Json @default("{}") @db.JsonB

  orgEntity OrgEntity @relation(fields: [orgEntityId], references: [id])
  owner     User?     @relation("RiskOwner", fields: [ownerUserId], references: [id])

  /// Composite: a risk cannot be raised against another entity's asset.
  asset Asset @relation(fields: [assetId, orgEntityId], references: [id, orgEntityId])

  /// Plain FKs — the libraries are global, so there is no entity axis to carry.
  threat        Threat        @relation(fields: [threatId], references: [id])
  vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  @@index([orgEntityId, retiredAt])
  @@index([assetId])
  @@map("risks")
}

/// The control library (02a:217) — the FIRST table where scope is a property of
/// the ROW rather than of the table (ADR-0014).
///
/// Every other business table here answers "may this principal touch this row?"
/// with one rule for the whole table. A control does not: `applies_to_scope =
/// group` makes a row readable group-wide while it stays writable only by its
/// owner. That is why this table's RLS is THREE per-command policies instead of
/// one FOR ALL — a single policy cannot hold a read scope and a write scope that
/// differ, because UPDATE and DELETE select their rows through the same USING
/// that reading widened. Measured, W06 Day 1; see the migration header.
///
/// ⚠️ NO `@@unique([id, org_entity_id])`, unlike AssetGroup and Asset. That pair
/// exists to let a child carry a composite FK, and the M7 `Risk ↔ Control` link
/// CANNOT use one: 02a:413 says a group-shared control may link to ANY entity's
/// risks, so the two org_entity_ids are expected to differ. Adding the anchor
/// now would encode an invariant this table's whole point is to break.
///
/// ⚠️ No `status` column — same reason as AssetGroup: 02a §4 defines lifecycles
/// for Policy, Risk, Issue and ControlTest only, and `effectiveness` is not a
/// lifecycle. Inventing states would breach 已確認參數 #9.
model Control {
  id String @id @default(uuid()) @db.Uuid

  /// `CTRL-<ENTITY_CODE>-<seq>`. Self-declared: 02a:91 fixes only the RULE
  /// (prefix by type and entity) and names no prefix for Control, so this is a
  /// choice being recorded — and, per W04's D3 ruling, recorded HERE rather than
  /// in a prefix registry nobody asked for.
  refCode String @unique @map("ref_code")

  /// NOT NULL even for a group-shared control (約束 8 iron law 1). A group row
  /// still has an owner — the entity accountable for it — which is precisely what
  /// the nullable alternative could not express (ADR-0014 §否決 B).
  orgEntityId String @map("org_entity_id") @db.Uuid

  title       String
  description String?

  type      ControlType
  nature    ControlNature
  frequency ControlFrequency

  /// Free-text clause references, e.g. `ISO 27001 A.5.9` (02a:217).
  ///
  /// ⚠️ An ARRAY OF STRINGS, not a foreign key. `Framework` and
  /// `FrameworkControl` do not exist (slice 4), and a FK to a missing table is
  /// not available to be right. When they arrive this column becomes the
  /// migration's input, not a second source of truth kept beside it.
  frameworkRefs String[] @default([]) @map("framework_refs")

  appliesToScope ControlAppliesToScope @default(entity) @map("applies_to_scope")

  /// Defaults to `not_tested` and stays there for all of Wave 1 — see the enum.
  effectiveness ControlEffectiveness @default(not_tested)

  ownerUserId String? @map("owner_user_id") @db.Uuid
  createdBy   String? @map("created_by") @db.Uuid
  updatedBy   String? @map("updated_by") @db.Uuid

  version    Int  @default(1)
  extensions Json @default("{}") @db.JsonB

  orgEntity OrgEntity     @relation(fields: [orgEntityId], references: [id])
  owner     User?         @relation("ControlOwner", fields: [ownerUserId], references: [id])
  tests     ControlTest[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  /// `applies_to_scope` leads: the group half of the read policy scans on it.
  @@index([appliesToScope, retiredAt])
  @@index([orgEntityId, retiredAt])
  @@map("controls")
}

/// One execution of a control test (02a:225) — the source 02a:418 specifies
/// `Control.effectiveness` derives from.
///
/// ⚠️ NO `result` COLUMN, though 02a:225 lists one. See ControlTestStatus: §4's
/// three terminal states already ARE the result.
///
/// ⭐ THE INTERESTING PART IS `control_id`, and it is the first reference in this
/// schema that a foreign key cannot secure on its own. Every earlier child closed
/// cross-entity references with a COMPOSITE key — assets.(asset_group_id,
/// org_entity_id) — and Control deliberately refuses the anchor that needs (see
/// Control's header: the M7 link table exists to join rows whose entities differ).
///
/// W07 Day 1 measured what a plain foreign key leaves open, against real
/// PostgreSQL: the referential-integrity check is NOT subject to row-level
/// security, so a principal scoped to HK1 successfully inserted a row naming an
/// SG1 control it cannot SELECT at all. Worse, an id that exists nowhere is
/// refused 23503 — so success versus 23503 told the caller "exists, not yours"
/// versus "absent", which is the 403-vs-404 oracle 約束 8 forbids, one layer below
/// anywhere HTTP code could fix it.
///
/// What closes it is a BEFORE INSERT OR UPDATE trigger running SECURITY INVOKER,
/// so its lookup is filtered by the same policies the caller reads under. Because
/// a BEFORE trigger runs AHEAD of the constraint, the absent id never reaches the
/// foreign key: both cases raise 42501 and are indistinguishable (measured, W07
/// Day 1 M5). Disabling the trigger turns the refusal back into a success, which
/// is how we know the trigger is what does the work (M8). See the migration.
model ControlTest {
  id String @id @default(uuid()) @db.Uuid

  /// `CTST-<ENTITY_CODE>-<seq>`. Self-declared, as Control's is: 02a:91 fixes the
  /// rule (prefix by type and entity) and names no prefix for this type.
  refCode String @unique @map("ref_code")

  orgEntityId String @map("org_entity_id") @db.Uuid

  /// N:1 and required (02a:410). Guarded by trigger, not by a composite key.
  controlId String @map("control_id") @db.Uuid

  status ControlTestStatus @default(scheduled)

  /// Both nullable: a test can be scheduled before it is performed, and recorded
  /// after the fact without ever having been scheduled. Neither is the normal
  /// case dressed as an exception.
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(6)
  performedAt  DateTime? @map("performed_at") @db.Timestamptz(6)

  testerUserId   String? @map("tester_user_id") @db.Uuid
  reviewerUserId String? @map("reviewer_user_id") @db.Uuid

  conclusion String?

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  version    Int  @default(1)
  extensions Json @default("{}") @db.JsonB

  orgEntity OrgEntity @relation(fields: [orgEntityId], references: [id])
  control   Control   @relation(fields: [controlId], references: [id])
  tester    User?     @relation("ControlTestTester", fields: [testerUserId], references: [id])
  reviewer  User?     @relation("ControlTestReviewer", fields: [reviewerUserId], references: [id])
  // No `evidence Evidence[]` back-relation: Evidence names this table by a bare
  // polymorphic uuid, so there is no relation for Prisma to walk back along.

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  @@index([orgEntityId, retiredAt])
  @@index([controlId, retiredAt])
  @@map("control_tests")
}

/// Evidence attached to a record (02a:227). Polymorphic by specification.
///
/// ⚠️ `linked_id` HAS NO FOREIGN KEY, and that is the specification rather than an
/// omission: 02a:227 links to test, attestation or assessment, and a column cannot
/// reference three tables. Prisma therefore models `controlTest` as a relation on
/// the ONE type that exists (EvidenceLinkedType), while the database column stays
/// a bare uuid — see the migration, which creates no constraint for it.
///
/// ⭐ W07 Day 1 measured what "no foreign key" costs when nothing else is watching:
/// a row pointing at another entity's record was accepted, and so was a row
/// pointing at an id that exists nowhere at all (M3, M3b). So the same trigger
/// ControlTest needs for a different reason does double duty here — it is both the
/// scope guard AND the absent referential integrity, and it fails closed for a
/// linked_type it does not know how to check.
model Evidence {
  id String @id @default(uuid()) @db.Uuid

  /// `EVID-<ENTITY_CODE>-<seq>`. Self-declared, same rule as the others.
  refCode String @unique @map("ref_code")

  orgEntityId String @map("org_entity_id") @db.Uuid

  /// Free text (02a:227 names no enumeration): "screenshot", "export", "log".
  /// Inventing a closed list here would be inventing a field (已確認參數 #9).
  kind String

  /// Where the artefact actually lives. A pointer, never the bytes: 04's
  /// classification and retention rules apply to the store, not to this row.
  uriOrBlobRef String @map("uri_or_blob_ref")

  /// Integrity anchor (02a:227). REQUIRED, not nullable — evidence whose contents
  /// cannot be shown to be unchanged is not evidence-grade (guardrail 5), and a
  /// nullable column would let the platform hold both kinds while claiming one.
  hash String

  collectedAt DateTime @map("collected_at") @db.Timestamptz(6)

  linkedType EvidenceLinkedType @map("linked_type")
  linkedId   String             @map("linked_id") @db.Uuid

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  version    Int  @default(1)
  extensions Json @default("{}") @db.JsonB

  orgEntity OrgEntity @relation(fields: [orgEntityId], references: [id])

  /// ⛔ NO Prisma relation for `linked_id`, deliberately. Declaring one would make
  /// Prisma emit a real foreign key to control_tests — which reads as tidier and
  /// would structurally break the thing this column is for: the day
  /// EvidenceLinkedType gains `attestation`, that key would reject every
  /// attestation id. A relation that must be deleted to add the second case was
  /// never modelling the first one correctly.
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  @@index([orgEntityId, retiredAt])
  @@index([linkedType, linkedId])
  @@map("evidence")
}
